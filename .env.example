# ---------- Branding ----------
NEXT_PUBLIC_APP_NAME=meme
NEXT_PUBLIC_APP_TAGLINE=Launch memes backed by memes

# ---------- Solana ----------
# Use a real RPC (Helius, Triton, QuickNode...). Public RPC will rate-limit you.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------- Secrets (server only) ----------
# 32-byte hex key used to encrypt per-token vault keypairs at rest. Generate: npm run gen-key
# Losing this key = losing access to every vault. Back it up.
VAULT_ENCRYPTION_KEY=

# Platform treasury wallet that receives the platform share of fees.
TREASURY_PUBKEY=

# ---------- Fee split (basis points of claimed creator fees, must sum to 10000) ----------
BACKING_BPS=5000      # bought into the backing meme and held in the vault
LAUNCHER_BPS=4000     # paid to the wallet that launched the token
TREASURY_BPS=1000     # paid to the platform treasury

# ---------- Launch settings ----------
# SOL the launcher deposits on top of their dev buy to cover create tx + rent + vault reserve
LAUNCH_OVERHEAD_SOL=0.05
MAX_DEV_BUY_SOL=10
# SOL kept in each vault for rent / ATA creation
VAULT_RESERVE_SOL=0.01

# ---------- Worker ----------
WORKER_INTERVAL_SEC=600
# Don't bother claiming / swapping below this many SOL
MIN_DISTRIBUTE_SOL=0.02
SWAP_SLIPPAGE_BPS=300

# ---------- External APIs (override if they move) ----------
PUMP_IPFS_URL=https://pump.fun/api/ipfs
PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
PRIORITY_FEE_SOL=0.0005

# SQLite file
DATABASE_PATH=./data/meme.db
